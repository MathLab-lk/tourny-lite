# ------------------------------------------------------------------------------
# Tourny Lite — deployment slot configuration (read by deploy/deploy.sh)
#
# The repo builds TWO containers from ONE repo folder, each from its own
# branch via a git worktree:
#
#   stable  →  http://127.0.0.1:8090  (tunnel-facing, production)
#   dev     →  http://127.0.0.1:8091  (localhost only, try-before-stable)
#
# These are DEFAULTS for this branch of the repo. For VM-specific overrides
# create deploy/deploy.local.env (gitignored) — it wins over this file:
#
#   STABLE_BRANCH=main
#   DEV_BRANCH=feature/next-thing
# ------------------------------------------------------------------------------

# Branch deployed on the STABLE slot
STABLE_BRANCH="${STABLE_BRANCH:-main}"

# Branch deployed on the DEV slot
DEV_BRANCH="${DEV_BRANCH:-feature/student-rankings}"
