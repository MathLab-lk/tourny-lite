# SQLite database file (adjust the path if needed)
DATABASE_URL=file:./db/custom.db

# Secret used to sign session cookies.
# Generate a production value with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-value

# WhatsApp sharing via WAHA (optional — normally configured by the
# administrator in Settings; these act as a headless fallback).
# WAHA_BASE_URL=https://wa-api.example.app
# WAHA_API_KEY=the-x-api-key-of-your-waha-server
# WAHA_SESSION=default
# WAHA_GROUP_CHAT_ID=1203630xxxxxxxxxxxx@g.us
# WAHA_AUTO_EVENTS=true
