generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Multi-Tournament Engine Schema
// Mirrors the architectural spec: tournaments, divisions,
// game_types, tournament_events, centers, event_results,
// audit_logs.
// ─────────────────────────────────────────────────────────────

model Tournament {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  organizer    String   @default("")
  status       String   @default("active") // draft | active | completed | archived
  pointsFirst  Int      @default(75)
  pointsSecond Int      @default(50)
  pointsThird  Int      @default(25)
  templateId   String? // preset identifier e.g. math_comp_2026
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  divisions Division[]
  games     GameType[]
  centers   Center[]
  students  Student[]
  events    TournamentEvent[]
  results   EventResult[]
}

model Division {
  id               String  @id @default(cuid())
  tournamentId     String
  code             String
  name             String
  ageRange         String  @default("")
  gradeRange       String  @default("")
  participantQuota Int     @default(5)
  displayOrder     Int     @default(1)

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  events     TournamentEvent[]

  @@unique([tournamentId, code])
  @@index([tournamentId])
}

model GameType {
  id           String @id @default(cuid())
  tournamentId String
  code         String
  englishName  String
  sinhalaName  String @default("")
  rulesSummary String @default("")

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  events     TournamentEvent[]

  @@unique([tournamentId, code])
  @@index([tournamentId])
}

model TournamentEvent {
  id            String @id @default(cuid())
  tournamentId  String
  divisionId    String
  gameId        String
  subEventIndex Int
  label         String
  status        String @default("pending") // pending | in_progress | completed
  // How this event is scored: "podium" = the classic 3-tap center
  // podium; "students" = individual student marks whose per-center
  // sums derive the podium automatically.
  scoringMode   String @default("podium") // podium | students

  tournament Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  division   Division      @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  game       GameType      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  result     EventResult?
  auditLogs  AuditLog[]
  studentScores StudentScore[]

  @@unique([divisionId, gameId, subEventIndex])
  @@index([tournamentId])
}

model Center {
  id          String @id @default(cuid())
  tournamentId String
  centerCode  String
  centerName  String @default("")
  location    String @default("")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  firstPlaceResults  EventResult[] @relation("FirstPlace")
  secondPlaceResults EventResult[] @relation("SecondPlace")
  thirdPlaceResults  EventResult[] @relation("ThirdPlace")
  students           Student[]

  @@unique([tournamentId, centerCode])
  @@index([tournamentId])
}

// ─────────────────────────────────────────────────────────────
// Students — individual competitors belonging to a center.
// They are identified by name in the field, but the system keys
// them on an internal id so two students with the same name never
// collide. centerId is nullable: the roster is often built on the
// go, and an unassigned student's marks count toward the student
// ranking but toward no center sum until they are assigned.
// ─────────────────────────────────────────────────────────────

model Student {
  id           String   @id @default(cuid())
  tournamentId String
  centerId     String?
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  center     Center?        @relation(fields: [centerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scores     StudentScore[]

  @@index([tournamentId])
  @@index([centerId])
}

// ─────────────────────────────────────────────────────────────
// Student marks — one score per student per event. Unlike center
// podiums (fixed marks per place), student marks are custom values
// typed off the field mark sheet. Per-event center sums of these
// marks decide the event's center podium (see student-service).
// ─────────────────────────────────────────────────────────────

model StudentScore {
  id           String   @id @default(cuid())
  tournamentId String
  eventId      String
  studentId    String
  marks        Float
  recordedBy   String   @default("")
  notes        String   @default("")
  recordedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event   TournamentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([tournamentId])
}

model EventResult {
  id                 String   @id @default(cuid())
  tournamentId       String
  eventId            String   @unique
  firstPlaceCenterId  String?
  secondPlaceCenterId String?
  thirdPlaceCenterId  String?
  recordedBy         String   @default("")
  notes              String   @default("")
  // True when the podium was derived from student marks rather
  // than picked manually — such results are corrected by editing
  // the student marks, never by moving podium places by hand.
  derivedFromStudents Boolean  @default(false)
  recordedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event        TournamentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  firstCenter  Center?         @relation("FirstPlace", fields: [firstPlaceCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  secondCenter Center?         @relation("SecondPlace", fields: [secondPlaceCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  thirdCenter  Center?         @relation("ThirdPlace", fields: [thirdPlaceCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tournamentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventId   String
  action    String // created | updated | reset
  oldValues String   @default("") // JSON snapshot
  newValues String   @default("") // JSON snapshot
  reason    String   @default("")
  actor     String   @default("")
  timestamp DateTime @default(now())

  event TournamentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ─────────────────────────────────────────────────────────────
// Accounts — authentication layer.
// Reading tournament data is public; every write requires a
// signed-in account. `admin` = organizer / M&E coordinator,
// `judge` = field scorekeeper. The first account created
// becomes the administrator (first-run setup).
// ─────────────────────────────────────────────────────────────

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String
  passwordHash   String
  role           String           @default("judge") // admin | judge
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  redeemedInvite InvitationCode?  @relation("InvitationRedemption")
}

// Invitation codes — the admin generates a code and shares it;
// the recipient uses it once to create their own account with
// the role baked into the code. No expiry unless set.
model InvitationCode {
  id        String    @id @default(cuid())
  code      String    @unique // 8 chars, unambiguous alphabet
  role      String    @default("judge") // admin | judge
  createdBy String    @default("") // admin name at generation time
  createdAt DateTime  @default(now())
  expiresAt DateTime? // null = never expires
  usedAt    DateTime? // set on redemption (single use)
  usedById  String?   @unique
  usedBy    User?     @relation("InvitationRedemption", fields: [usedById], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────────────────────────
// App-level settings — small key/value store (JSON values) for
// configuration that admins manage from the UI instead of env
// vars (e.g. the WhatsApp sharing connection). Never holds data
// that belongs to a single tournament.
// ─────────────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     String // JSON payload
  updatedAt DateTime @updatedAt
}
